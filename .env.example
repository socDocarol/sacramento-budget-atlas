# Public ArcGIS source used by default.
BUDGET_ARCGIS_URL=https://services5.arcgis.com/54falWtcpty3V47Z/arcgis/rest/services/City_of_Sacramento_Approved_Budgets/FeatureServer/0

# Local runtime cache. This directory is intentionally excluded from Git.
BUDGET_CACHE_DIR=.cache
BUDGET_CACHE_TTL_SECONDS=86400
BUDGET_PREPARED_SCHEMA_VERSION=1

# Keep enabled for a clean clone. Disable only after a prepared cache exists.
BUDGET_BACKGROUND_REFRESH_ENABLED=1

# Manual source refresh is disabled unless explicitly enabled. If enabled,
# every process enforces this minimum interval between accepted requests.
BUDGET_MANUAL_REFRESH_ENABLED=0
BUDGET_MANUAL_REFRESH_COOLDOWN_SECONDS=300

LOG_LEVEL=INFO
APP_BASE_PATH=/

# Comma-separated Host values accepted by the ASGI boundary. Configure the
# exact Azure default/custom domains before deployment.
APP_ALLOWED_HOSTS=localhost,127.0.0.1
